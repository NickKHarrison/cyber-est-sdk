    "check": "node scripts/sdk-publish.mjs",
    "est": "node sdk/packages/cli/bin/est.mjs",
    "est:dev": "node sdk/devhost/bin/est-dev.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.0.5",
    "ajv": "8.20.0",
    "assemblyscript": "0.28.20",
    "binaryen": "132.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
