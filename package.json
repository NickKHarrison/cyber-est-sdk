{
  "name": "cyber-est-sdk",
  "private": true,
  "version": "1.489.0",
  "description": "The EST plugin kit for Cyber: the sources of @cyber-est/cli, @cyber-est/tools and @cyber-est/ui. Mirrored from Cyber's repository.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickKHarrison/cyber-est-sdk.git"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "vitest run",
    "build": "node scripts/sdk-build.mjs",
