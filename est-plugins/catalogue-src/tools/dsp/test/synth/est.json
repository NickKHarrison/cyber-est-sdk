{
  "$schema": "../../../../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.dsp-toolkit-synth",
  "version": "1.0.0",
  "name": "DSP Toolkit Test Synth",
  "vendor": "Example",
  "description": "The DSP toolkit's test instrument: sine voices on the toolkit's allocator, envelope and step clock, rendered by sdk/tests/dspToolkit.test.ts. Not a catalogue plugin.",
  "license": "MIT",
  "kind": "instrument",
  "features": ["instrument", "synthesizer", "stereo"],
  "abi": { "est": "1.0", "clap": "1.2" },
  "module": { "path": "module.wasm" },
  "assets": [],
  "audio": { "inputs": [], "outputs": [{ "channels": 2 }], "sampleRates": "any" },
  "notes": { "inputs": 1, "outputs": 0 },
  "limits": { "maxLatencyFrames": 0, "memoryPagesMax": 16, "tailSeconds": 30 },
  "parameters": [
    { "id": 1, "name": "Steal fade", "unit": "ms" },
    { "id": 2, "name": "Sustain", "unit": "%" },
    { "id": 3, "name": "Release", "unit": "s" },
    { "id": 4, "name": "Clock" },
    { "id": 5, "name": "Swing", "unit": "%" },
    { "id": 6, "name": "Policy" },
    { "id": 7, "name": "Decay", "unit": "s" },
    { "id": 20, "name": "Active" },
    { "id": 21, "name": "Held" },
    { "id": 22, "name": "Key sum" },
    { "id": 23, "name": "Waiting" },
    { "id": 24, "name": "Steps fired" },
    { "id": 25, "name": "Step in bar" },
    { "id": 26, "name": "Step index" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": { "host": ">=1.0.0 <2" }
}
