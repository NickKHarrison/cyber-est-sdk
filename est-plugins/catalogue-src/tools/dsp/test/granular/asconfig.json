{
  "targets": {
    "release": {
      "outFile": "build/granular.wasm",
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": true
    }
  },
  "options": {
    "path": ["../../../../../../sdk/as"],
    "runtime": "../../../../../../sdk/as/est/runtime",
    "initialMemory": 64,
    "use": ["abort=index/abort"],
    "disable": ["gc", "exception-handling", "relaxed-simd", "threads", "tail-calls"]
  }
}
