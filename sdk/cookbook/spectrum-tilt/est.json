{
  "$schema": "../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.cookbook-spectrum-tilt",
  "version": "1.0.0",
  "name": "Cookbook Spectrum Tilt",
  "vendor": "Example",
  "description": "A tilt EQ (lows down as highs go up around a pivot) whose own window draws its output's spectrum from the host's analysis, never from samples.",
  "license": "MIT",
  "kind": "effect",
  "features": ["audio-effect", "equalizer", "stereo"],
  "abi": { "est": "1.1", "clap": "1.2" },
  "module": { "path": "module.wasm" },
  "ui": { "path": "ui/index.html", "size": { "w": 560, "h": 300 }, "audio": true },
  "assets": [],
  "audio": { "inputs": [{ "channels": 2 }], "outputs": [{ "channels": 2 }], "sampleRates": "any" },
  "notes": { "inputs": 0, "outputs": 0 },
  "limits": { "maxLatencyFrames": 0, "memoryPagesMax": 16, "tailSeconds": 0 },
  "parameters": [
    { "id": 0, "name": "Tilt", "unit": "dB" },
    { "id": 1, "name": "Pivot", "unit": "Hz", "scale": "log" },
    { "id": 2, "name": "Output", "unit": "dB" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": { "host": ">=1.0.0 <2" }
}
