{
  "$schema": "../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.cookbook-widener",
  "version": "1.0.0",
  "name": "Cookbook Stereo Widener",
  "vendor": "Example",
  "description": "A stereo widener: the signal as mid and side, the side scaled by Width (0 % mono, 100 % unchanged, 200 % twice as wide).",
  "license": "MIT",
  "kind": "effect",
  "features": ["audio-effect", "utility", "stereo"],
  "abi": {
    "est": "1.0",
    "clap": "1.2"
  },
  "module": {
    "path": "module.wasm"
  },
  "assets": [],
  "audio": {
    "inputs": [
      {
        "channels": 2
      }
    ],
    "outputs": [
      {
        "channels": 2
      }
    ],
    "sampleRates": "any"
  },
  "notes": {
    "inputs": 0,
    "outputs": 0
  },
  "limits": {
    "maxLatencyFrames": 0,
    "memoryPagesMax": 16,
    "tailSeconds": 0
  },
  "parameters": [
    { "id": 0, "name": "Width", "unit": "%" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": {
    "host": ">=1.0.0 <2"
  }
}
