{
  "$schema": "../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.cookbook-bitcrusher",
  "version": "1.0.0",
  "name": "Cookbook Bitcrusher",
  "vendor": "Example",
  "description": "A bitcrusher: the signal quantised to fewer bits and held for several samples, mixed with the dry signal.",
  "license": "MIT",
  "kind": "effect",
  "features": ["audio-effect", "distortion", "stereo"],
  "abi": {
    "est": "1.0",
    "clap": "1.2"
  },
  "module": {
    "path": "module.wasm"
  },
  "assets": [],
  "audio": {
    "inputs": [
      {
        "channels": 2
      }
    ],
    "outputs": [
      {
        "channels": 2
      }
    ],
    "sampleRates": "any"
  },
  "notes": {
    "inputs": 0,
    "outputs": 0
  },
  "limits": {
    "maxLatencyFrames": 0,
    "memoryPagesMax": 16,
    "tailSeconds": 0
  },
  "parameters": [
    { "id": 0, "name": "Bits" },
    { "id": 1, "name": "Downsample" },
    { "id": 2, "name": "Mix", "unit": "%" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": {
    "host": ">=1.0.0 <2"
  }
}
