{
  "$schema": "../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.cookbook-auto-wah",
  "version": "1.0.0",
  "name": "Cookbook Auto-Wah",
  "vendor": "Example",
  "description": "An auto-wah: an envelope follower on the input sweeps a resonant band-pass filter up from Base by up to Range octaves.",
  "license": "MIT",
  "kind": "effect",
  "features": ["audio-effect", "filter", "stereo"],
  "abi": {
    "est": "1.0",
    "clap": "1.2"
  },
  "module": {
    "path": "module.wasm"
  },
  "assets": [],
  "audio": {
    "inputs": [
      {
        "channels": 2
      }
    ],
    "outputs": [
      {
        "channels": 2
      }
    ],
    "sampleRates": "any"
  },
  "notes": {
    "inputs": 0,
    "outputs": 0
  },
  "limits": {
    "maxLatencyFrames": 0,
    "memoryPagesMax": 16,
    "tailSeconds": 1
  },
  "parameters": [
    { "id": 0, "name": "Sensitivity", "unit": "dB" },
    { "id": 1, "name": "Base", "unit": "Hz" },
    { "id": 2, "name": "Range", "unit": "oct" },
    { "id": 3, "name": "Resonance" },
    { "id": 4, "name": "Mix", "unit": "%" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": {
    "host": ">=1.0.0 <2"
  }
}
