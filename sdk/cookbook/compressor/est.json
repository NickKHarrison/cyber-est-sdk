{
  "$schema": "../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.cookbook-compressor",
  "version": "1.0.0",
  "name": "Cookbook Compressor",
  "vendor": "Example",
  "description": "A peak compressor with threshold, ratio, attack, release and make-up gain, its channels linked.",
  "license": "MIT",
  "kind": "effect",
  "features": ["audio-effect", "compressor", "stereo"],
  "abi": {
    "est": "1.0",
    "clap": "1.2"
  },
  "module": {
    "path": "module.wasm"
  },
  "assets": [],
  "audio": {
    "inputs": [
      {
        "channels": 2
      }
    ],
    "outputs": [
      {
        "channels": 2
      }
    ],
    "sampleRates": "any"
  },
  "notes": {
    "inputs": 0,
    "outputs": 0
  },
  "limits": {
    "maxLatencyFrames": 0,
    "memoryPagesMax": 16,
    "tailSeconds": 0
  },
  "parameters": [
    { "id": 0, "name": "Threshold", "unit": "dB" },
    { "id": 1, "name": "Ratio" },
    { "id": 2, "name": "Attack", "unit": "ms" },
    { "id": 3, "name": "Release", "unit": "ms" },
    { "id": 4, "name": "Makeup", "unit": "dB" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": {
    "host": ">=1.0.0 <2"
  }
}
