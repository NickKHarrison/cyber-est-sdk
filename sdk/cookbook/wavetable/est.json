{
  "$schema": "../../../src/audio/est/abi/est-manifest-1.schema.json",
  "est": 1,
  "id": "org.example.cookbook-wavetable",
  "version": "1.0.0",
  "name": "Cookbook Wavetable",
  "vendor": "Example",
  "description": "A wavetable synth: four single-cycle waves (sine, triangle, saw, square) morphed by Position, six voices with an envelope.",
  "license": "MIT",
  "kind": "instrument",
  "features": ["instrument", "synthesizer", "stereo"],
  "abi": {
    "est": "1.0",
    "clap": "1.2"
  },
  "module": {
    "path": "module.wasm"
  },
  "assets": [],
  "audio": {
    "inputs": [],
    "outputs": [
      {
        "channels": 2
      }
    ],
    "sampleRates": "any"
  },
  "notes": {
    "inputs": 1,
    "outputs": 0
  },
  "limits": {
    "maxLatencyFrames": 0,
    "memoryPagesMax": 16,
    "tailSeconds": 5
  },
  "parameters": [
    { "id": 0, "name": "Level", "unit": "dB" },
    { "id": 1, "name": "Position" },
    { "id": 2, "name": "Attack", "unit": "ms" },
    { "id": 3, "name": "Release", "unit": "ms" }
  ],
  "stateVersion": 1,
  "permissions": [],
  "compat": {
    "host": ">=1.0.0 <2"
  }
}
