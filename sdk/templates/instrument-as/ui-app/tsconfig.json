{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["main.ts", "store.ts", "engine.ts", "bridge.ts", "bits.ts", "fonts.ts", "env.d.ts", "../est-ui.d.ts"]
}
